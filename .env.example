# Copy to .env and fill in only the settings you need. The device does not load
# .env files: pass values through the process environment or a secret manager.
# Keep .env private. Never commit an API key or instance CRN.
# The credential values below are dummy examples; replace them with your own.

# IBM Cloud API key, not an IAM bearer token. Required unless supplied through
# a session parameter or an explicit key file.
# IBM_QUANTUM_API_KEY=00000000000000000000000000000000000000000000

# Instance Cloud Resource Name (CRN). Required unless supplied explicitly.
# IBM_QUANTUM_INSTANCE_CRN=crn:v1:bluemix:public:quantum-computing:us-east:a/00000000000000000000000000000000:00000000-0000-0000-0000-000000000000::

# Backend name for the generic ibm.default device. Concrete catalogue entries
# and explicit backend names override this value.
# IBM_QUANTUM_BACKEND=ibm_berlin

# Optional TLS CA bundle. SSL_CERT_FILE is used if CURL_CA_BUNDLE is unset or
# empty. Invalid explicit paths fail the request; verification stays enabled.
# CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Optional MQT Core device catalogue path. Find the installed path with
# `ibm-qdmi --catalog_path`.
# MQT_CORE_QDMI_CONFIG_FILE=.venv/lib/python3.13/site-packages/ibm/qdmi/data/lib/ibm-qdmi-device.qdmi.json
