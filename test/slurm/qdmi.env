# Synthetic values for the offline HTTP fixture; no IBM access.
IBM_QUANTUM_API_KEY=synthetic-key
IBM_QUANTUM_INSTANCE_CRN=crn:v1:bluemix:public:quantum-computing:us-east:a:instance::
MQT_CORE_QDMI_CONFIG_JSON='{"schema-version":1,"qdmi":{"devices":[{"id":"ibm.berlin","session":{"base-url":"http://127.0.0.1:18080","auth-url":"http://127.0.0.1:18080/auth"}}]}}'
