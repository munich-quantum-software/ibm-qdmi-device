PROJECT_NAME           = "IBM QDMI Device"
PROJECT_BRIEF          = "Unimplemented IBM device declarations and upstream QDMI context"
OUTPUT_DIRECTORY       = _build/doxygen
INPUT                  = "@CMAKE_CURRENT_BINARY_DIR@/include/ibm_qdmi" \
                         "@IBM_QDMI_UPSTREAM_HEADERS@"
FILE_PATTERNS          = *.h *.hpp
RECURSIVE              = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = ..
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
GENERATE_XML           = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_TAGFILE       =
QUIET                  = YES
WARNINGS               = YES
WARN_AS_ERROR          = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE =
